{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio personal estático (HTML, CSS y JavaScript vanilla).",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "python3 -m http.server 8765",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:html": "htmlhint \"pages/**/*.html\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "htmlhint": "1.9.2",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "vitest": "5.1.0"
  }
}
